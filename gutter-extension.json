{
  "gutter": 1,
  "id": "rust",
  "name": "Rust",
  "version": "0.1.0",
  "languages": [{ "id": "rust", "extensions": ["rs"] }],
  "servers": [
    {
      "id": "rust-analyzer",
      "languages": ["rust"],
      "command": ["${setting:serverPath}"],
      "rootMarkers": ["Cargo.toml"],
      "initializationOptions": { "checkOnSave": false },
      "install": [
        {
          "download": {
            "windows-x64": {
              "url": "https://github.com/rust-lang/rust-analyzer/releases/download/2026-11-16/rust-analyzer-x86_64-pc-windows-msvc.zip",
              "sha256": "dbf0c36ec54cf727d34cc40c9994fe71b7d52e3c28a3112c3deca1aba46fbc8f",
              "extract": "zip",
              "file": "rust-analyzer.exe"
            },
            "windows-arm64": {
              "url": "https://github.com/rust-lang/rust-analyzer/releases/download/2026-11-16/rust-analyzer-aarch64-pc-windows-msvc.zip",
              "sha256": "2e8fd876300eeee87afd6de18c79eb17bab425a9b755043c63d5023d58de37b7",
              "extract": "zip",
              "file": "rust-analyzer.exe"
            },
            "macos-x64": {
              "url": "https://github.com/rust-lang/rust-analyzer/releases/download/2026-11-16/rust-analyzer-x86_64-apple-darwin.gz",
              "sha256": "6901d956b4f2b091343eaf3570944098488f3ffec018987145285ed8253c07d2",
              "extract": "gz"
            },
            "macos-arm64": {
              "url": "https://github.com/rust-lang/rust-analyzer/releases/download/2026-11-16/rust-analyzer-aarch64-apple-darwin.gz",
              "sha256": "608b7c7d6bec1fcd6c964578b1f8234888afe6d6c0e7915284f1e2fd36ef1343",
              "extract": "gz"
            },
            "linux-x64": {
              "url": "https://github.com/rust-lang/rust-analyzer/releases/download/2026-11-16/rust-analyzer-x86_64-unknown-linux-gnu.gz",
              "sha256": "4a08727a03094e5114db4438e4bd1d6182cc26eff37d6962115ea1ec1a491ca3",
              "extract": "gz"
            },
            "linux-arm64": {
              "url": "https://github.com/rust-lang/rust-analyzer/releases/download/2026-11-16/rust-analyzer-aarch64-unknown-linux-gnu.gz",
              "sha256": "73d8b9b87384b3115a183a8a51db9f7c205ce4c89ea511f3c8c8fea863038a50",
              "extract": "gz"
            }
          },
          "to": "rust-analyzer${exe}",
          "executable": true
        }
      ]
    }
  ],
  "settings": [
    { "key": "serverPath", "label": "rust-analyzer", "type": "path", "default": "${serverDir}/rust-analyzer${exe}" }
  ]
}
